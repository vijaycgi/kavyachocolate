# Copy to .env and fill in. Never commit real secrets.

# PostgreSQL. The app connects with the pooled URL; the Prisma CLI uses the
# direct URL for migrations. On Vercel these are injected by the Neon
# integration (Storage -> Create Database -> Neon).
DATABASE_URL="postgresql://user:password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Seeded admin credentials (only used when the admin row is first created).
# Admin sign-in is separate from customer accounts.
ADMIN_EMAIL="admin@kavya.local"
ADMIN_PASSWORD="ChangeMe123!"
ADMIN_NAME="Kavya Chocolat Owner"

# Public site URL, used for metadata and absolute links in account emails. On
# Vercel this can be omitted; the production domain is used as the fallback.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional transactional email through Resend's HTTPS API. Without both
# values the account flows still work, but verification/reset links are only
# logged to the server console in development. Production shows an honest
# "email not configured" state instead of pretending a message was sent.
# RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
# EMAIL_FROM="Kavya Chocolat <accounts@your-verified-domain.example>"

# Optional Google sign-in. Create an OAuth 2.0 Client (Web application) in
# Google Cloud Console and register both callback URLs:
#   http://localhost:3000/api/auth/google/callback
#   https://your-production-domain/api/auth/google/callback
# Leave these unset to keep the Google button visibly disabled with a clear
# explanation. No login is simulated.
# GOOGLE_CLIENT_ID="1234567890-xxxxxxxxxxxxxxxx.apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="GOCSPX-xxxxxxxxxxxxxxxxxxxx"
