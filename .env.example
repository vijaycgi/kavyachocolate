# Copy to .env and fill in. Never commit real secrets.

# PostgreSQL. The app connects with the pooled URL; the Prisma CLI uses the
# direct URL for migrations. On Vercel these are injected by the Neon
# integration (Storage -> Create Database -> Neon).
DATABASE_URL="postgresql://user:password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Seeded admin credentials (only used when the admin row is first created).
ADMIN_EMAIL="admin@kavya.local"
ADMIN_PASSWORD="ChangeMe123!"
ADMIN_NAME="Kavya Chocolat Owner"

# Public site URL, used for metadata and absolute links. On Vercel this can be
# omitted; the deployment's own production domain is used as the fallback.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional: transactional email is not implemented in this build.
# RESEND_API_KEY=""
# ORDER_FROM_EMAIL=""
