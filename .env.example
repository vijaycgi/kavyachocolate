# Copy to .env and fill in. Never commit real secrets.

# Development uses SQLite. For production use PostgreSQL and update prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# Seeded admin credentials (change before deploying).
ADMIN_EMAIL="admin@kavya.local"
ADMIN_PASSWORD="ChangeMe123!"
ADMIN_NAME="Kavya Chocolat Owner"

# Public site URL, used for metadata and absolute links.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional: transactional email is not implemented in this build.
# RESEND_API_KEY=""
# ORDER_FROM_EMAIL=""
